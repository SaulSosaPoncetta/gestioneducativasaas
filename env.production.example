# Copiar a .env en el VPS y completar. Nunca subir el .env al repo.
APP_NAME="Gestión Educativa"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://geducativa.migestion.com.ar
APP_TIMEZONE=America/Argentina/Buenos_Aires

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_AR

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gestioneducativa
DB_USERNAME=gestioneducativa
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=240
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Email (avisos de comunicados). Ejemplo con el correo de Hostinger:
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=no-responder@migestion.com.ar
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-responder@migestion.com.ar
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
