@startuml
autonumber
skinparam BoxPadding 10
skinparam ParticipantPadding 12

actor "Actor\n(Admin/Sec/Est)" as Actor
box "Capa de Presentación" 
    participant "CarreraConsultasUI\n(Pantalla)" as UI
end box
box "Capa de Negocio" 
    participant "CarreraController" as Ctrl
    participant "SessionManager" as Session
end box
box "Capa de Datos" 
    participant "Base de Datos" as DB
end box

== Fase 1: Acceso al Módulo y Carga del Listado ==

Actor -> UI: Acceder al módulo de carreras
activate UI

UI -> Ctrl: iniciarModuloCarreras()
activate Ctrl

== Verificación de Precondición ==

Ctrl -> Session: verificarSesionActiva()
activate Session
return sesionValidaOk

Ctrl -> DB: obtenerTodasLasCarreras()
activate DB

alt Excepción 2: Error de consulta (Fallo de base de datos)
    DB --> Ctrl: error: SQLException / ConnectionTimeout
    Ctrl --> UI: error: No se pudo recuperar la información
    UI --> Actor: Mostrar mensaje "Error de consulta, reintente más tarde"
else Consulta física exitosa
    return registrosCarreras
    
    alt Excepción 1: No existen carreras (Lista vacía)
        Ctrl --> UI: listaVacia
        UI --> Actor: Mostrar listado vacío con mensaje "No hay carreras registradas en el sistema"
    else Registros encontrados (Flujo Normal Inicial)
        Ctrl --> UI: listaCarreras
        deactivate Ctrl
        UI --> Actor: Muestra el listado de las carreras disponibles
        deactivate UI
    end
end

== Fase 2: Selección y Consulta de Detalle ==

Actor -> UI: Seleccionar una carrera específica del listado (Paso 4)
activate UI

UI -> Ctrl: obtenerDetalleCarrera(carreraId)
activate Ctrl

Ctrl -> DB: buscarCarreraPorId(carreraId)
activate DB
return detalleCarrera

Ctrl --> UI: renderizarDetalleCarrera(detalleCarrera)
deactivate Ctrl

UI --> Actor: El sistema muestra la información detallada de la carrera
deactivate UI

@enduml