@startuml
skinparam Style strictuml
skinparam ActivityFontSize 12
skinparam ActivityFontName Arial

title Diagrama de Actividad: CU-50 - Consultar Información Académica

|Administrador / Secretaría / Estudiante|
start
:Selecciona el módulo académico correspondiente;

|Interfaz|
:Solicitar consulta de información académica;

|Sistema|
:Verificar autenticación del usuario;

if (§¿Usuario autenticado?) then (Si)
  :Identificar contexto del usuario y rol\n(Administrador/Secretaría o Estudiante);
  
  if (§¿Usuario posee autorización\npara el módulo?) then (Si)
    :Recuperar la información académica\n(estudiantes, materias, cursadas, notas, finales);
    
    if (§¿Consulta exitosa?) then (Si)
      :Aplicar relaciones académicas correspondientes\nsegún el alcance del usuario;
      
      if (§¿Existe información académica?) then (Si)
        |Interfaz|
        :Mostrar resultados e información académica;
        
        |Administrador / Secretaría / Estudiante|
        :Visualizar la información académica consultada;
        stop
      else (No)
        |Interfaz|
        :Mostrar mensaje: No existe información\nacadémica registrada para este contexto;
        
        |Administrador / Secretaría / Estudiante|
        :Visualizar pantalla sin registros;
        stop
      endif

    else (No)
      |Interfaz|
      :Mostrar mensaje de error\nde lectura / consulta en BD;
      
      |Administrador / Secretaría / Estudiante|
      :Visualizar mensaje de error;
      stop
    endif

  else (No)
    |Interfaz|
    :Mostrar mensaje de error:\nUsuario sin autorización para este módulo;
    
    |Administrador / Secretaría / Estudiante|
    :Visualizar aviso de acceso denegado;
    stop
  endif

else (No)
  |Interfaz|
  :Mostrar error y redirigir\na pantalla de Login;
  
  |Administrador / Secretaría / Estudiante|
  :Acceder a inicio de sesión;
  stop
endif

@enduml